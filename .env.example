# App (required for running the frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Setup script only (required for pnpm run setup-family)
# Find this in Supabase Dashboard → Settings → API → service_role key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# DB password (for supabase link)
SUPABASE_DB_PASSWORD=your-db-password

# Typesafe Jev API key, read only by the categorize-tasks edge function (it files
# shopping-list items into shop departments). The function does not see this file:
# locally put the same line in supabase/functions/.env.local, in production run
# `supabase secrets set TYPESAFE_API_KEY=...`. Without it items stay under "Ostalo".
TYPESAFE_API_KEY=your-typesafe-jev-api-key
